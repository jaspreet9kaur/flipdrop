<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>FlipDrop</AssemblyName>
    <RootNamespace>FlipDrop.App</RootNamespace>
    <Version>1.1.0</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>flipdrop.ico</ApplicationIcon>
    <!-- PerMonitorV2 is declared in app.manifest for WPF; WinForms' DPI-API warning does not apply. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>

  <!-- WPF is the UI framework; WinForms is used only for the tray icon (NotifyIcon) and GDI+
       icon/sample rendering. Drop the WinForms System.Drawing implicit global using so the many
       WPF types (Color, Brush, Brushes, FontFamily, ColorConverter) resolve unambiguously.
       AppIcon.cs and SampleImage.cs opt back in with explicit `using System.Drawing;`. -->
  <ItemGroup>
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FlipDrop.Core\FlipDrop.Core.csproj" />
  </ItemGroup>

</Project>

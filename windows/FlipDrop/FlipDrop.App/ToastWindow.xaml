<Window x:Class="FlipDrop.App.ToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize"
        SizeToContent="Height" Width="340"
        Focusable="False" ShowActivated="False">
  <Grid Margin="10,8,10,10">
    <Border x:Name="Card" CornerRadius="16" Background="{DynamicResource CardBg}"
            BorderBrush="{DynamicResource CardBorder}" BorderThickness="1"
            RenderTransformOrigin="0.5,0.5">
      <Border.RenderTransform>
        <TransformGroup>
          <ScaleTransform x:Name="CardScale" ScaleX="1" ScaleY="1"/>
          <TranslateTransform x:Name="Slide" X="28"/>
        </TransformGroup>
      </Border.RenderTransform>
      <Border.Effect>
        <DropShadowEffect BlurRadius="30" ShadowDepth="7" Opacity="0.26" Color="#55000000"/>
      </Border.Effect>

      <Grid Margin="14,13,12,13">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header: thumbnail/icon + text -->
        <Grid Grid.Row="0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>

          <Border x:Name="ThumbHost" Grid.Column="0" Width="54" Height="54" CornerRadius="12"
                  ClipToBounds="True" VerticalAlignment="Top">
            <Grid>
              <Image x:Name="ThumbImage" Stretch="UniformToFill" Visibility="Collapsed"/>
              <ContentControl x:Name="IconHost" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
          </Border>

          <StackPanel Grid.Column="1" Margin="12,1,0,0" VerticalAlignment="Center">
            <TextBlock x:Name="StatusLabel" Text="Landed in FlipDrop" FontSize="11"
                       FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}"/>
            <TextBlock x:Name="NameText" Text="" FontSize="14.5" FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
              <Border x:Name="KindChip" CornerRadius="6" Padding="7,2" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                  <Ellipse x:Name="KindDot" Width="7" Height="7" VerticalAlignment="Center"/>
                  <TextBlock x:Name="KindText" Text="" FontSize="11" FontWeight="SemiBold"
                             Margin="5,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
              </Border>
              <TextBlock x:Name="MetaText" Text="" FontSize="11.5" VerticalAlignment="Center"
                         Margin="9,0,0,0" Foreground="{DynamicResource TextSecondary}"
                         TextTrimming="CharacterEllipsis"/>
            </StackPanel>
          </StackPanel>
        </Grid>

        <!-- Progress (while receiving) -->
        <Grid x:Name="ProgressHost" Grid.Row="1" Margin="0,12,0,0" Visibility="Collapsed">
          <Border Height="6" CornerRadius="3" Background="{DynamicResource HoverBg}"/>
          <Border x:Name="ProgressFill" Height="6" CornerRadius="3" HorizontalAlignment="Stretch"
                  Background="{StaticResource FlipGradient}" RenderTransformOrigin="0,0.5">
            <Border.RenderTransform>
              <ScaleTransform x:Name="ProgressScale" ScaleX="0"/>
            </Border.RenderTransform>
          </Border>
        </Grid>

        <!-- Actions (when landed) -->
        <StackPanel x:Name="ActionHost" Grid.Row="2" Orientation="Horizontal"
                    Margin="0,13,0,0" Visibility="Collapsed">
          <Button x:Name="OpenBtn" Style="{StaticResource PillButton}" Content="Open"
                  Padding="16,7" FontSize="12.5" Margin="0,0,8,0"/>
          <Button x:Name="FolderBtn" Style="{StaticResource GhostButton}" Content="Show in folder"
                  Padding="12,7" FontSize="12.5"/>
        </StackPanel>
      </Grid>
    </Border>

    <Button x:Name="CloseBtn" Width="22" Height="22" HorizontalAlignment="Right" VerticalAlignment="Top"
            Margin="0,0,2,0" Cursor="Hand" ToolTip="Dismiss">
      <Button.Template>
        <ControlTemplate TargetType="Button">
          <Border Background="#99000000" CornerRadius="11">
            <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                       Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
        </ControlTemplate>
      </Button.Template>
    </Button>
  </Grid>
</Window>

<Window x:Class="FlipDrop.App.ToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize"
        SizeToContent="Manual" Width="236" Height="176"
        Focusable="False" ShowActivated="False">
  <Grid>
    <Border x:Name="Card" CornerRadius="16" Background="White" Cursor="Hand"
            RenderTransformOrigin="0.5,0.5">
      <Border.RenderTransform>
        <TranslateTransform x:Name="Slide" Y="18"/>
      </Border.RenderTransform>
      <Border.Effect>
        <DropShadowEffect BlurRadius="28" ShadowDepth="6" Opacity="0.30" Color="#55000000"/>
      </Border.Effect>
      <Grid Margin="8">
        <Grid.RowDefinitions>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" CornerRadius="10" ClipToBounds="True">
          <Border.Background>
            <ImageBrush x:Name="Thumb" Stretch="UniformToFill"/>
          </Border.Background>
        </Border>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="4,7,4,2">
          <Ellipse Width="16" Height="16" VerticalAlignment="Center">
            <Ellipse.Fill>
              <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#FFFF8A3D" Offset="0"/>
                <GradientStop Color="#FFE24AA0" Offset="0.55"/>
                <GradientStop Color="#FF8A5BE0" Offset="1"/>
              </LinearGradientBrush>
            </Ellipse.Fill>
          </Ellipse>
          <TextBlock Text="Landed in FlipDrop" Margin="7,0,0,0" VerticalAlignment="Center"
                     FontSize="12.5" FontWeight="SemiBold" Foreground="#FF1C1C1E"
                     FontFamily="Segoe UI Variable Text, Segoe UI"/>
        </StackPanel>
      </Grid>
    </Border>
    <Button x:Name="CloseBtn" Width="22" Height="22" HorizontalAlignment="Right" VerticalAlignment="Top"
            Margin="0,2,2,0" Cursor="Hand" ToolTip="Dismiss">
      <Button.Template>
        <ControlTemplate TargetType="Button">
          <Border Background="#CC000000" CornerRadius="11">
            <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                       Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
        </ControlTemplate>
      </Button.Template>
    </Button>
  </Grid>
</Window>

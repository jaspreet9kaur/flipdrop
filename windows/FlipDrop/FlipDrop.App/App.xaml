<Application x:Class="FlipDrop.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <ResourceDictionary>

      <!-- Palette -->
      <Color x:Key="WindowBgColor">#FFEFF1F5</Color>
      <SolidColorBrush x:Key="WindowBg" Color="{StaticResource WindowBgColor}"/>
      <SolidColorBrush x:Key="SidebarBg" Color="#FFF7F8FA"/>
      <SolidColorBrush x:Key="CardBg" Color="#FFFFFFFF"/>
      <SolidColorBrush x:Key="CardBorder" Color="#FFE3E6EC"/>
      <SolidColorBrush x:Key="TextPrimary" Color="#FF1C1C1E"/>
      <SolidColorBrush x:Key="TextSecondary" Color="#FF8A8A8E"/>
      <SolidColorBrush x:Key="AccentBrush" Color="#FFE24AA0"/>
      <SolidColorBrush x:Key="HoverBg" Color="#FFECEEF3"/>
      <SolidColorBrush x:Key="SelectBg" Color="#FFEAF0FF"/>

      <LinearGradientBrush x:Key="FlipGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFFF8A3D" Offset="0"/>
        <GradientStop Color="#FFE24AA0" Offset="0.55"/>
        <GradientStop Color="#FF8A5BE0" Offset="1"/>
      </LinearGradientBrush>

      <!-- Base text -->
      <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
      </Style>

      <!-- Sidebar nav item (RadioButton) -->
      <Style x:Key="NavItem" TargetType="RadioButton">
        <Setter Property="Margin" Value="10,2"/>
        <Setter Property="Padding" Value="12,9"/>
        <Setter Property="FontSize" Value="13.5"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="RadioButton">
              <Border x:Name="b" Background="Transparent" CornerRadius="9" Padding="{TemplateBinding Padding}">
                <ContentPresenter VerticalAlignment="Center"/>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="b" Property="Background" Value="{StaticResource HoverBg}"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                  <Setter TargetName="b" Property="Background" Value="{StaticResource SelectBg}"/>
                  <Setter Property="FontWeight" Value="SemiBold"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- Primary pill button -->
      <Style x:Key="PillButton" TargetType="Button">
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="18,9"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Button">
              <Border x:Name="b" CornerRadius="10" Background="{StaticResource FlipGradient}" Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="b" Property="Opacity" Value="0.9"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                  <Setter TargetName="b" Property="Opacity" Value="0.78"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- Secondary (light) button -->
      <Style x:Key="GhostButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Padding" Value="14,8"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Button">
              <Border x:Name="b" CornerRadius="9" Background="White" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="b" Property="Background" Value="{StaticResource HoverBg}"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- iOS-style toggle switch (CheckBox) -->
      <Style x:Key="ToggleSwitch" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="CheckBox">
              <Border x:Name="track" Width="46" Height="28" CornerRadius="14" Background="#FFD4D6DC">
                <Border x:Name="knob" Width="22" Height="22" CornerRadius="11" Background="White"
                        HorizontalAlignment="Left" Margin="3,0,0,0">
                  <Border.Effect>
                    <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.25"/>
                  </Border.Effect>
                </Border>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsChecked" Value="True">
                  <Setter TargetName="track" Property="Background" Value="{StaticResource FlipGradient}"/>
                  <Setter TargetName="knob" Property="HorizontalAlignment" Value="Right"/>
                  <Setter TargetName="knob" Property="Margin" Value="0,0,3,0"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- Segmented edge chooser (RadioButton) -->
      <Style x:Key="SegItem" TargetType="RadioButton">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="RadioButton">
              <Border x:Name="b" Background="Transparent" CornerRadius="8" Padding="16,7" Margin="2">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="b" Property="Background" Value="{StaticResource HoverBg}"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                  <Setter TargetName="b" Property="Background" Value="White"/>
                  <Setter Property="FontWeight" Value="SemiBold"/>
                  <Setter TargetName="b" Property="Effect">
                    <Setter.Value>
                      <DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.18"/>
                    </Setter.Value>
                  </Setter>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

    </ResourceDictionary>
  </Application.Resources>
</Application>
